# ──────────────────────────────────────────────────────────────────────────
# MikroTik Monitor — Environment Variables
# ──────────────────────────────────────────────────────────────────────────
# Schema canonical source: apps/api/src/config/env.ts
# All vars below MUST be in sync with that schema.
# Generate secrets:  openssl rand -hex 32   (or  openssl rand -base64 32)
# ──────────────────────────────────────────────────────────────────────────

# ─── Core ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mikrotik_monitor
TZ=Asia/Makassar

# ─── Security & Auth ──────────────────────────────────────────────────────
BETTER_AUTH_SECRET=change_this_to_a_secure_random_string_better_auth_secret
BETTER_AUTH_URL=http://localhost:3001/api/auth
# JWT_SECRET=                  # optional (legacy auth fallback)
# SESSION_SECRET=              # optional (legacy session store)
# PORTAL_TOKEN_SECRET=         # optional (member portal magic-link token)
ENCRYPTION_KEY=change_this_to_a_secure_random_string_at_least_32_chars
# PROD_ENCRYPTION_KEY=         # optional (rotation key for prod re-encrypt)
METRICS_BEARER_TOKEN=change_this_to_a_secure_random_string_for_prometheus_metrics
CORS_ORIGIN=http://localhost:5173
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174
# SECURITY: kalau true, izinkan webhook/upstream call ke private IP ranges
# (10.x, 172.16-31.x, 192.168.x). Default false untuk SSRF prevention.
ALLOW_PRIVATE_NETWORKS=false

# ─── External Services ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
GENIEACS_URL=http://localhost:7557
APP_URL=http://localhost:3001
# WEBHOOK_BASE_URL=https://your-public-domain.tld  # untuk MikroTik webhook
# GEMINI_API_KEY=              # AI diagnosis (optional)
# GOOGLE_MAPS_API_KEY=         # Map satellite tiles (optional)
# SENTRY_DSN=                  # Error tracking (optional)

# ─── Infrastructure (paths) ───────────────────────────────────────────────
PG_DUMP_PATH=pg_dump
PSQL_PATH=psql
VPN_BASE_DIR=/etc/openvpn
VPN_DISABLE_SYSTEMD=false
# MIKHMON_LOGO_DIR=            # optional logo dir untuk MikHMON voucher print

# ─── Polling & Scheduler Tuning ───────────────────────────────────────────
SYNC_ENABLED=true
ROUTER_SYNC_CONCURRENCY=5
OLT_SYNC_CONCURRENCY=3
QUEUE_BP_WAITING_LIMIT=100

# ─── Adaptive Scaling (auto-tune polling per cluster size) ────────────────
ADAPTIVE_BASE_MS=60000
ADAPTIVE_MAX_MULTIPLIER=5

# ─── Circuit Breaker (per-router fail protection) ─────────────────────────
ROUTER_CB_THRESHOLD=5
ROUTER_CB_COOLDOWN_MS=60000

# ─── Netwatch Auto-Heal ───────────────────────────────────────────────────
NETWATCH_AUTOHEAL_ENABLED=true
NETWATCH_AUTOHEAL_COOLDOWN_MS=300000
NETWATCH_AUTOHEAL_FLAP_THRESHOLD=3
NETWATCH_WEBHOOK_DEBUG=false

# ─── Audit Retention ──────────────────────────────────────────────────────
GLOBAL_AUDIT_RETENTION_DAYS=365

# ─── Billing ──────────────────────────────────────────────────────────────
BILLING_TZ=Asia/Makassar

# ─── HSGQ OLT (debug-only, default off) ───────────────────────────────────
HSGQ_DEBUG_FIELDS=false
# HSGQ_DEBUG_SN=               # serial number untuk targeted debug

# ─── Backup Repair (one-off operations) ───────────────────────────────────
REPAIR_DB_FORCE_DECOMPRESS=false
