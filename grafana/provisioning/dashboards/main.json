  "panels": [
    {
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "DEVICE STATUS OVERVIEW",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "device_router_status_count{router_name=~\"$router\"}",
          "legendFormat": "Status {{status}} - {{router_name}}",
          "refId": "A"
        }
      ],
      "title": "Router Status",
      "type": "state-timeline"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 1 },
      "id": 3,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "device_olt_status_count",
          "legendFormat": "OLT {{status}}",
          "refId": "A"
        }
      ],
      "title": "OLTs (Global)",
      "type": "state-timeline"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 1 },
      "id": 4,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "device_onu_status_count",
          "legendFormat": "ONU {{status}}",
          "refId": "A"
        }
      ],
      "title": "ONUs (Global)",
      "type": "state-timeline"
    },
    {
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 200,
      "title": "INTERFACE TRAFFIC HISTORY",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "unit": "bps"
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "TX" },
            "properties": [
              { "id": "color", "options": { "fixedColor": "green", "mode": "fixed" } },
              { "id": "displayName", "options": "TX Rate" }
            ]
          },
          {
            "matcher": { "id": "byFrameRefID", "options": "RX" },
            "properties": [
              { "id": "color", "options": { "fixedColor": "blue", "mode": "fixed" } },
              { "id": "displayName", "options": "RX Rate" }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "id": 201,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "repeat": "interface",
      "repeatDirection": "v",
      "targets": [
        {
          "expr": "app_interface_traffic_tx_bps{router_name=~\"$router\", interface_name=~\"$interface\"}",
          "legendFormat": "{{interface_name}} - TX",
          "refId": "TX"
        },
        {
          "expr": "app_interface_traffic_rx_bps{router_name=~\"$router\", interface_name=~\"$interface\"}",
          "legendFormat": "{{interface_name}} - RX",
          "refId": "RX"
        }
      ],
      "title": "Traffic: $interface",
      "type": "timeseries"
    },
    {
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 101,
      "title": "ALERTS & INCIDENTS",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 17 },
      "id": 5,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "pieType": "pie",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "expr": "sum(app_alert_count{router_name=~\"$router\"}) by (severity)",
          "legendFormat": "{{severity}}",
          "refId": "A"
        }
      ],
      "title": "Alerts by Severity",
      "type": "piechart"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 17 },
      "id": 6,
      "options": {
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "expr": "sum(app_alert_count{router_name=~\"$router\"}) by (type)",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ],
      "title": "Active Alerts by Type",
      "type": "bargauge"
    },
    {
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "id": 102,
      "title": "NETWORK & TRAFFIC",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "continuous-GrYlRd" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 80 }] }, "unit": "none" },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 26 },
      "id": 7,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "text": {}
      },
      "targets": [
        {
          "expr": "sum(app_pppoe_sessions_active_count{router_name=~\"$router\"})",
          "refId": "A"
        }
      ],
      "title": "Active PPPoE Sessions",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 18, "x": 6, "y": 26 },
      "id": 8,
